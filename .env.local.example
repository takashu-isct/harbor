# このファイルは「どんな設定が必要か」を示す見本です。
# 実際の値は .env.local という別ファイルにコピーして書き込んでください。
# .env.local はGitHubには上げません(.gitignoreで除外済み)。

# --- Googleログイン(Auth.js)用 ---
# Google Cloud Consoleで「OAuthクライアントID」を作成すると発行されます
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Auth.jsが内部でセッション情報を暗号化するための鍵(自分で決める文字列でOK)
# 生成コマンド例: npx auth secret
AUTH_SECRET=

# --- Googleスプレッドシート(サービスアカウント)用 ---
# 読み書き対象のスプレッドシートのID(URLの /d/ と /edit の間の文字列)
GOOGLE_SHEET_ID=
# サービスアカウントのメールアドレス
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# サービスアカウントの秘密鍵(JSONキーの private_key の値をそのまま貼り付け)
GOOGLE_PRIVATE_KEY=
